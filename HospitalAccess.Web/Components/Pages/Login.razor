@page "/login"
@rendermode InteractiveServer
@using HospitalAccess.Web.Services
@inject ApiClient Api
@inject AuthState AuthState
@inject NavigationManager Nav

<PageTitle>Login</PageTitle>

<div class="login-wrapper">
    <div class="form-panel login-card">
        <h3 class="mb-1">Controle de Acesso Hospitalar</h3>
        <p class="text-muted mb-4">Entre com suas credenciais para continuar.</p>

        <EditForm Model="_model" FormName="LoginForm" OnValidSubmit="SubmitAsync">
            <div class="mb-3">
                <label class="form-label">Usuário</label>
                <InputText class="form-control" @bind-Value="_model.Username" autofocus />
            </div>
            <div class="mb-3">
                <label class="form-label">Senha</label>
                <InputText type="password" class="form-control" @bind-Value="_model.Password" />
            </div>
            @if (_error is not null)
            {
                <div class="alert alert-danger py-2">@_error</div>
            }
            <button type="submit" class="btn btn-primary w-100" disabled="@_busy">@(_busy ? "Entrando..." : "Entrar")</button>
        </EditForm>
    </div>
</div>

<style>
    .login-wrapper {
        display: flex;
        justify-content: center;
        align-items: flex-start;
        padding-top: 4rem;
    }

    .login-card {
        width: 100%;
        max-width: 380px;
    }
</style>

@code {
    private readonly LoginModel _model = new();
    private string? _error;
    private bool _busy;

    private async Task SubmitAsync()
    {
        _busy = true;
        _error = null;
        var result = await Api.LoginAsync(_model.Username, _model.Password);
        _busy = false;

        if (result is null)
        {
            _error = "Usuário ou senha inválidos.";
            return;
        }

        AuthState.SignIn(result.Token, result.Role, _model.Username);
        Nav.NavigateTo("/");
    }

    private sealed class LoginModel
    {
        public string Username { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }
}
