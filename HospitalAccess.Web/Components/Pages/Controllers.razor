@page "/controllers"
@rendermode InteractiveServer
@using HospitalAccess.Web.Services
@inject ApiClient Api
@inject AuthState AuthState
@inject NavigationManager Nav

<PageTitle>Controladores / Portas</PageTitle>

<h3>Controladores (8190H / A33_Face)</h3>
<p class="text-muted">Cada controlador representa fisicamente uma única porta — não há cadastro de porta separado.</p>

@if (IsAdminOrOperator)
{
    <button class="btn btn-outline-primary btn-sm mb-3" @onclick="DiscoverAsync" disabled="@_discovering">
        @(_discovering ? "Procurando..." : "Descobrir controladores na rede")
    </button>
    @if (_discovered is not null)
    {
        @if (_discovered.Count == 0)
        {
            <p class="text-muted">Nenhum controlador respondeu à varredura (isso é esperado se não houver hardware real acessível neste ambiente).</p>
        }
        else
        {
            <ul class="mb-3">
                @foreach (var d in _discovered)
                {
                    <li><code>@d.SerialNumber</code> — @d.IpAddress</li>
                }
            </ul>
        }
    }
}

<div class="form-panel mb-4">
    <EditForm Model="_model" FormName="ControllerForm" OnValidSubmit="SaveAsync" class="row g-2 align-items-end">
        <div class="col-md-2">
            <label class="form-label">Nome</label>
            <InputText class="form-control" @bind-Value="_model.Name" placeholder="Ex.: Portaria Principal" />
        </div>
        <div class="col-md-2">
            <label class="form-label">IP</label>
            <InputText class="form-control" @bind-Value="_model.IpAddress" />
        </div>
        <div class="col-md-1">
            <label class="form-label">Porta</label>
            <InputNumber class="form-control" @bind-Value="_model.Port" />
        </div>
        <div class="col-md-2">
            <label class="form-label">SN (16 dígitos)</label>
            <InputText class="form-control" @bind-Value="_model.SerialNumber" />
        </div>
        <div class="col-md-2">
            <label class="form-label">Senha (8 hex)</label>
            <InputText class="form-control" @bind-Value="_model.CommunicationPassword" />
        </div>
        <div class="col-md-1 form-check">
            <InputCheckbox class="form-check-input" @bind-Value="_model.SupportsWaitRepeatMessage" id="waitRepeat" />
            <label class="form-check-label" for="waitRepeat">Firmware &gt;= v4.28</label>
        </div>
        <div class="col-md-2">
            <button class="btn btn-primary" type="submit">@(_editingId is null ? "Adicionar" : "Salvar")</button>
            @if (_editingId is not null)
            {
                <button class="btn btn-outline-secondary" type="button" @onclick="CancelEdit">Cancelar</button>
            }
        </div>
    </EditForm>
</div>
@if (_formError is not null)
{
    <div class="alert alert-danger">@_formError</div>
}

<div class="filter-bar mb-3">
    <label class="form-label">Buscar</label>
    <input type="text" class="form-control" placeholder="Nome, IP ou SN..." @bind="_search" @bind:event="oninput" />
</div>

<table class="table table-hover align-middle">
    <thead>
        <tr><th>Nome</th><th>IP:Porta</th><th>SN</th><th>Usuários</th><th>Ações</th></tr>
    </thead>
    <tbody>
        @foreach (var c in FilteredControllers)
        {
            <tr>
                <td>@c.Name</td>
                <td>@c.IpAddress:@c.Port</td>
                <td><code>@c.SerialNumber</code></td>
                <td><span class="badge bg-secondary">@c.UserCount</span></td>
                <td>
                    <div class="btn-group btn-group-sm" role="group">
                        <button class="btn btn-primary" @onclick="() => OpenModal(c.Id)">Controlar</button>
                        <a class="btn btn-outline-dark" href="@($"controllers/{c.Id}")">Detalhes</a>
                        @if (IsAdminOrOperator)
                        {
                            <button class="btn btn-outline-secondary" @onclick="() => EditAsync(c.Id)">Editar</button>
                            <button class="btn btn-outline-danger" @onclick="() => DeleteAsync(c.Id)">Excluir</button>
                        }
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (_modalController is not null)
{
    <div class="modal-backdrop-custom" @onclick="CloseModal"></div>
    <div class="modal-dialog-custom">
        <div class="modal-content-custom" @onclick:stopPropagation="true">
            <div class="modal-header-custom">
                <h5>@_modalController.Name</h5>
                <button type="button" class="btn-close" aria-label="Fechar" @onclick="CloseModal"></button>
            </div>
            <div class="modal-body-custom">
                <p class="text-muted mb-3"><code>@_modalController.IpAddress:@_modalController.Port</code> — SN <code>@_modalController.SerialNumber</code></p>

                <h6>Comandos de porta</h6>
                <div class="btn-group btn-group-sm mb-2" role="group">
                    <button class="btn btn-success" @onclick="() => DoorCommandAsync(_modalController.Id, Api.OpenDoorAsync)">Abrir</button>
                    <button class="btn btn-outline-secondary" @onclick="() => DoorCommandAsync(_modalController.Id, Api.CloseDoorAsync)">Fechar</button>
                    @if (IsAdminOrOperator)
                    {
                        <button class="btn btn-outline-warning" @onclick="() => DoorCommandAsync(_modalController.Id, Api.HoldDoorOpenAsync)">Manter aberta</button>
                        <button class="btn btn-outline-danger" @onclick="() => DoorCommandAsync(_modalController.Id, Api.LockDoorAsync)">Trancar</button>
                        <button class="btn btn-outline-dark" @onclick="() => DoorCommandAsync(_modalController.Id, Api.UnlockDoorAsync)">Destrancar</button>
                    }
                </div>
                @if (_doorCommandResult is not null)
                {
                    <p class="mb-3">@_doorCommandResult</p>
                }

                <hr />

                <h6>Diagnóstico</h6>
                <div class="btn-group btn-group-sm mb-2" role="group">
                    <button class="btn btn-outline-info" @onclick="() => TestConnectionAsync(_modalController.Id)">Testar conexão</button>
                    <button class="btn btn-outline-info" @onclick="() => ToggleSyncStatusAsync(_modalController.Id)">Status de sincronização</button>
                </div>
                @if (_testResult is not null)
                {
                    <p class="mb-2">@_testResult</p>
                }
                @if (_syncStatuses.Count > 0)
                {
                    <ul class="mb-0">
                        @foreach (var s in _syncStatuses)
                        {
                            <li>@s.UserName — <span class="badge @SyncBadgeClass(s.State)">@s.State</span> (retries: @s.RetryCount) @(s.LastError is null ? "" : $"— {s.LastError}")</li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
}

@code {
    private List<ControllerDto> _controllers = [];
    private readonly FormModel _model = new();
    private Guid? _editingId;
    private string? _formError;
    private ControllerDto? _modalController;
    private string? _testResult;
    private string? _doorCommandResult;
    private List<SyncStatusDto> _syncStatuses = [];
    private bool _discovering;
    private List<DiscoveredController>? _discovered;
    private string _search = string.Empty;

    private bool IsAdminOrOperator => AuthState.Role is "Admin" or "Operator";

    private IEnumerable<ControllerDto> FilteredControllers => _controllers.Where(c =>
        string.IsNullOrWhiteSpace(_search) ||
        c.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
        c.IpAddress.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
        c.SerialNumber.Contains(_search, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        if (!AuthState.IsAuthenticated) { Nav.NavigateTo("/login"); return; }
        await LoadAsync();
    }

    private async Task LoadAsync() => _controllers = await Api.GetControllersAsync();

    private async Task SaveAsync()
    {
        _formError = null;

        if (_editingId is null)
        {
            var response = await Api.CreateControllerAsync(new CreateControllerRequest(
                _model.Name, _model.IpAddress, _model.Port, _model.SerialNumber,
                _model.CommunicationPassword, _model.SupportsWaitRepeatMessage));
            if (!response.IsSuccessStatusCode)
            {
                _formError = await response.Content.ReadAsStringAsync();
                return;
            }
        }
        else
        {
            var response = await Api.UpdateControllerAsync(_editingId.Value, new UpdateControllerRequest(
                _model.Name, _model.IpAddress, _model.Port, _model.SerialNumber,
                _model.CommunicationPassword, _model.SupportsWaitRepeatMessage, 0, 3000, 3));
            if (!response.IsSuccessStatusCode)
            {
                _formError = await response.Content.ReadAsStringAsync();
                return;
            }
        }

        CancelEdit();
        await LoadAsync();
    }

    private async Task EditAsync(Guid id)
    {
        var detail = await Api.GetControllerAsync(id);
        if (detail is null) return;

        _editingId = id;
        _model.Name = detail.Name;
        _model.IpAddress = detail.IpAddress;
        _model.Port = detail.Port;
        _model.SerialNumber = detail.SerialNumber;
        _model.CommunicationPassword = detail.CommunicationPassword;
        _model.SupportsWaitRepeatMessage = detail.SupportsWaitRepeatMessage;
    }

    private void CancelEdit()
    {
        _editingId = null;
        _model.Name = string.Empty;
        _model.IpAddress = string.Empty;
        _model.Port = 8101;
        _model.SerialNumber = string.Empty;
        _model.CommunicationPassword = "FFFFFFFF";
        _model.SupportsWaitRepeatMessage = false;
    }

    private async Task DiscoverAsync()
    {
        _discovering = true;
        _discovered = null;
        StateHasChanged();
        _discovered = await Api.DiscoverControllersAsync(60000, 4);
        _discovering = false;
    }

    private async Task DeleteAsync(Guid id)
    {
        _formError = null;
        var response = await Api.DeleteControllerAsync(id);
        if (!response.IsSuccessStatusCode)
        {
            _formError = await response.Content.ReadAsStringAsync();
            return;
        }
        await LoadAsync();
    }

    private void OpenModal(Guid id)
    {
        _modalController = _controllers.FirstOrDefault(c => c.Id == id);
        _testResult = null;
        _doorCommandResult = null;
        _syncStatuses = [];
    }

    private void CloseModal()
    {
        _modalController = null;
        _testResult = null;
        _doorCommandResult = null;
        _syncStatuses = [];
    }

    private async Task TestConnectionAsync(Guid id)
    {
        _syncStatuses = [];
        _doorCommandResult = null;
        var (ok, message) = await Api.TestConnectionAsync(id);
        _testResult = ok ? $"OK: {message}" : $"Falha: {message}";
    }

    private async Task ToggleSyncStatusAsync(Guid id)
    {
        _testResult = null;
        _doorCommandResult = null;
        _syncStatuses = await Api.GetSyncStatusAsync(id);
    }

    private async Task DoorCommandAsync(Guid id, Func<Guid, Task<(bool ok, string message)>> command)
    {
        _testResult = null;
        _syncStatuses = [];
        var (ok, message) = await command(id);
        _doorCommandResult = ok ? "Comando enviado com sucesso." : $"Falha: {message}";
    }

    private static string SyncBadgeClass(string state) => state switch
    {
        "Synced" => "bg-success",
        "Failed" => "bg-danger",
        "Revoked" => "bg-secondary",
        _ => "bg-warning text-dark",
    };

    private sealed class FormModel
    {
        public string Name { get; set; } = string.Empty;
        public string IpAddress { get; set; } = string.Empty;
        public int Port { get; set; } = 8101;
        public string SerialNumber { get; set; } = string.Empty;
        public string CommunicationPassword { get; set; } = "FFFFFFFF";
        public bool SupportsWaitRepeatMessage { get; set; }
    }
}
