@page "/visitors"
@rendermode InteractiveServer
@using HospitalAccess.Web.Services
@inject ApiClient Api
@inject AuthState AuthState
@inject NavigationManager Nav

<PageTitle>Visitantes</PageTitle>

<h3>Visitantes / temporários (acesso por QR)</h3>

<EditForm Model="_model" FormName="VisitorForm" OnValidSubmit="CreateAsync" class="col-md-6 form-panel mb-4">
    <div class="mb-3">
        <label class="form-label">Nome</label>
        <InputText class="form-control" @bind-Value="_model.Name" />
    </div>
    <div class="mb-3">
        <label class="form-label">Válido até</label>
        <InputDate Type="InputDateType.DateTimeLocal" class="form-control" @bind-Value="_model.ValidUntil" />
    </div>
    <div class="mb-3">
        <label class="form-label">Grupo de horário (1-64)</label>
        <InputNumber class="form-control" @bind-Value="_model.TimeGroup" />
    </div>
    @if (_error is not null)
    {
        <div class="alert alert-danger">@_error</div>
    }
    <button type="submit" class="btn btn-primary" disabled="@_busy">Cadastrar e gerar QR</button>
</EditForm>

@if (_qrImageBase64 is not null)
{
    <div class="mb-4">
        <h4>QR de acesso — @_qrVisitorName</h4>
        <img src="data:image/png;base64,@_qrImageBase64" alt="QR de acesso" style="max-width: 300px;" />
    </div>
}

<div class="filter-bar mb-3 row g-2 align-items-end">
    <div class="col-md-5">
        <label class="form-label">Buscar</label>
        <input type="text" class="form-control" placeholder="Nome..." @bind="_search" @bind:event="oninput" />
    </div>
    <div class="col-md-4">
        <label class="form-label">Status</label>
        <select class="form-select" @bind="_statusFilter">
            <option value="">(todos)</option>
            <option value="ativo">Ativo</option>
            <option value="expirado">Expirado</option>
            <option value="revogado">Revogado</option>
        </select>
    </div>
</div>

<table class="table table-hover align-middle">
    <thead>
        <tr><th>Nome</th><th>Código</th><th>Válido de</th><th>Válido até</th><th>Status</th><th>Ações</th></tr>
    </thead>
    <tbody>
        @foreach (var v in FilteredVisitors)
        {
            <tr>
                <td>@v.Name</td>
                <td>@v.UserCode</td>
                <td>@v.ValidFrom?.ToLocalTime().ToString("g")</td>
                <td>@v.ValidUntil?.ToLocalTime().ToString("g")</td>
                <td><span class="badge @StatusBadgeClass(v)">@StatusLabel(v)</span></td>
                <td>
                    @if (!v.IsRevoked)
                    {
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => ShowQrAsync(v.Id, v.Name)">Ver QR</button>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => RevokeAsync(v.Id)">Revogar</button>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@code {
    private readonly CreateModel _model = new() { ValidUntil = DateTime.Now.AddDays(1) };
    private string? _error;
    private string? _qrImageBase64;
    private string _qrVisitorName = string.Empty;
    private bool _busy;
    private List<VisitorListItemDto> _visitors = [];
    private string _search = string.Empty;
    private string _statusFilter = string.Empty;

    private IEnumerable<VisitorListItemDto> FilteredVisitors => _visitors.Where(v =>
        (string.IsNullOrWhiteSpace(_search) || v.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(_statusFilter) || StatusLabel(v).Equals(_statusFilter, StringComparison.OrdinalIgnoreCase)));

    protected override async Task OnInitializedAsync()
    {
        if (!AuthState.IsAuthenticated) { Nav.NavigateTo("/login"); return; }
        await LoadAsync();
    }

    private async Task LoadAsync() => _visitors = await Api.GetVisitorsAsync();

    private async Task CreateAsync()
    {
        _error = null;
        _qrImageBase64 = null;

        if (_model.ValidUntil <= DateTime.Now) { _error = "Validade deve ser no futuro."; return; }
        if (_model.TimeGroup is < 1 or > 64) { _error = "Grupo de horário deve estar entre 1 e 64."; return; }

        _busy = true;
        var createResponse = await Api.CreateVisitorAsync(new CreateVisitorRequest(_model.Name, _model.ValidUntil.ToUniversalTime(), _model.TimeGroup));
        if (!createResponse.IsSuccessStatusCode)
        {
            _busy = false;
            _error = await createResponse.Content.ReadAsStringAsync();
            return;
        }

        var created = await createResponse.Content.ReadFromJsonAsync<CreateUserResponse>();
        _busy = false;

        if (created is not null)
            await ShowQrAsync(created.Id, _model.Name);

        _model.Name = string.Empty;
        await LoadAsync();
    }

    private async Task ShowQrAsync(Guid visitorId, string name)
    {
        var png = await Api.GenerateVisitorQrAsync(visitorId);
        if (png is null)
        {
            _error = "Falha ao gerar o QR.";
            return;
        }
        _qrVisitorName = name;
        _qrImageBase64 = Convert.ToBase64String(png);
    }

    private async Task RevokeAsync(Guid id)
    {
        _error = null;
        var response = await Api.RevokeVisitorAsync(id);
        if (!response.IsSuccessStatusCode)
        {
            _error = await response.Content.ReadAsStringAsync();
            return;
        }
        await LoadAsync();
    }

    private static string StatusLabel(VisitorListItemDto v) =>
        v.IsRevoked ? "Revogado" : v.IsExpired ? "Expirado" : "Ativo";

    private static string StatusBadgeClass(VisitorListItemDto v) =>
        v.IsRevoked ? "bg-secondary" : v.IsExpired ? "bg-danger" : "bg-success";

    private sealed class CreateModel
    {
        public string Name { get; set; } = string.Empty;
        public DateTime ValidUntil { get; set; }
        public int TimeGroup { get; set; } = 1;
    }
}
