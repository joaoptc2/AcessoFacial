<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="HospitalAccess.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <!--
      Referência EXPLÍCITA e na mesma versão do EntityFrameworkCore. O provider Npgsql 10.0.3
      depende de Relational 10.0.4; sem esta linha, o build resolve Core 10.0.11 com Relational
      10.0.4 e emite MSB3277 (conflito de versão entre assemblies do mesmo pacote). Alinhar as
      três em 10.0.11 zera o aviso — o provider liga normalmente ao patch mais novo.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\HospitalAccess.Application\HospitalAccess.Application.csproj" />
    <ProjectReference Include="..\HospitalAccess.Domain\HospitalAccess.Domain.csproj" />
  </ItemGroup>
</Project>
