<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    ImageSharp.Drawing/Fonts 1.x: desenho do NOME do paciente na tela de boas-vindas (módulo de
    leitos). Pareados com o ImageSharp 2.1 fixado no Gateway (Apache-2.0) — NÃO subir para as
    versões pareadas com ImageSharp 3.x sem revisar a "Six Labors Split License".
  -->
  <ItemGroup>
    <PackageReference Include="SixLabors.ImageSharp.Drawing" Version="1.0.0" />
    <PackageReference Include="SixLabors.Fonts" Version="1.0.0" />
  </ItemGroup>
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>ccf33596-affe-43b6-8ef9-1e041b431a95</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="HospitalAccess.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.10">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\HospitalAccess.Application\HospitalAccess.Application.csproj" />
    <ProjectReference Include="..\HospitalAccess.Infrastructure\HospitalAccess.Infrastructure.csproj" />
    <ProjectReference Include="..\HospitalAccess.Gateway\HospitalAccess.Gateway.csproj" />
    <ProjectReference Include="..\HospitalAccess.Domain\HospitalAccess.Domain.csproj" />
  </ItemGroup>
</Project>
